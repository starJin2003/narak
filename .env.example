# Copy to .env.local and set your Meta Model API key on the server only.
# Never use a NEXT_PUBLIC_ variable for credentials.
MODEL_API_KEY=replace_with_your_meta_model_api_key

# Server-only PostgreSQL connection using a role with USAGE on schema narak
# and SELECT on its tables. Use verified TLS for Supabase (sslmode=verify-full).
DATABASE_URL=""

# LOCAL TOOLING ONLY: never set DATABASE_MIGRATION_URL in Vercel project settings.
# The application does not import migration or intake scripts.
# Privileged direct/session connection for approved migrations only.
# Never use the transaction pooler for migrations. Keep the Data API disabled.
DATABASE_MIGRATION_URL=""

# Vercel: paste the complete trusted Supabase CA PEM into this server-only value.
# Real newlines or literal \n separators are supported. Takes precedence over file.
# Obtain the CA from Supabase's official distribution; never disable TLS checks.
DATABASE_CA_CERT=""

# Local development fallback. Preserve the private certificate on your machine.
# Leave unset in Vercel when DATABASE_CA_CERT is supplied.
DATABASE_CA_CERT_PATH=""
